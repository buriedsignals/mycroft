#!/usr/bin/env bash
# Mycroft is uninstalled through Indicator Labs. This file remains so old
# public-installer wrappers fail closed instead of applying a cached bootstrap.
set -euo pipefail

JOIN='https://buriedsignals.com/join'

cat <<EOF
Mycroft is uninstalled in Indicator Labs, not by this script.

Journalists: $JOIN
Contributors: uninstall Mycroft from Indicator Labs against the local checkout.

There is no signed public-installer uninstall channel.
EOF
exit 1
