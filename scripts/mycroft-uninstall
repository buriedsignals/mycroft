#!/usr/bin/env bash
# This fail-closed pointer does not uninstall Mycroft. Indicator Labs owns the
# managed path; Engine owns the open-source path.
set -euo pipefail

JOIN='https://buriedsignals.com/join'

cat <<EOF
This script is a fail-closed pointer; it does not uninstall Mycroft.

Managed users: uninstall in Indicator Labs at $JOIN
Open-source users: review and apply: bsig plan uninstall mycroft

There is no signed public-installer uninstall channel.
EOF
exit 1
